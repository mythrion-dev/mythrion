// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  passwordHash       String?
  displayName        String?
  onboardingComplete Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  adventures         Adventure[]
  memberships        CampaignMember[]
  sentInvitations    CampaignInvitation[] @relation("SentInvitations")
  joinRequests       JoinRequest[]
  ownedTemplates     Template[]
  googleAccount      GoogleAccount?
  refreshTokens      RefreshToken[]
  characterSheets    CharacterSheet[]
  subscription       UserSubscription?
}

model Adventure {
  id              String               @id @default(cuid())
  name            String
  campaign        String
  synopsis        String?
  maxPlayers      Int                  @default(5)
  sessionWeekday  String?              // "Monday", "Tuesday", etc.
  sessionTime     String?              // "HH:mm" format, e.g. "20:00"
  sessionType     String?              // "ONLINE" or "IN_PERSON"
  ownerId         String
  owner           User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isPublic             Boolean              @default(false)
  templateSource       String?              @map("template_source")
  templateSnapshot     Json?                @map("template_snapshot")
  originalTemplateId   String?
  originalTemplate     Template?            @relation("OriginalTemplateForAdventure", fields: [originalTemplateId], references: [id], onDelete: SetNull)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  members              CampaignMember[]
  invitations          CampaignInvitation[]
  joinRequests         JoinRequest[]
  templates            Template[]
  characterSheets      CharacterSheet[]
  books                Book[]
  @@index([ownerId])
  @@index([originalTemplateId])
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model JoinRequest {
  id          String             @id @default(cuid())
  adventureId String
  adventure   Adventure          @relation(fields: [adventureId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      JoinRequestStatus  @default(PENDING)
  message     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([adventureId, userId])
  @@index([adventureId])
  @@index([userId])
  @@index([status])
}

enum MemberRole {
  GM
  PLAYER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum BookVisibility {
  GM_BOOK
  PLAYER_BOOK
}

model Book {
  id            String         @id @default(cuid())
  adventureId   String
  adventure     Adventure      @relation(fields: [adventureId], references: [id], onDelete: Cascade)
  name          String
  visibility    BookVisibility @default(GM_BOOK)
  fileLength    Int            @default(0)
  gridfsFileId  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([adventureId])
}

model CampaignMember {
  id          String     @id @default(cuid())
  adventureId String
  adventure   Adventure  @relation(fields: [adventureId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        MemberRole
  joinedAt    DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([adventureId, userId])
  @@index([userId])
}

model CampaignInvitation {
  id           String           @id @default(cuid())
  adventureId  String
  adventure    Adventure        @relation(fields: [adventureId], references: [id], onDelete: Cascade)
  invitedEmail String?
  token        String           @unique
  role         MemberRole
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdById  String
  createdBy    User             @relation("SentInvitations", fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([adventureId])
  @@index([token])
}

model GoogleAccount {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @unique
  googleId    String   @unique
  email       String
  displayName String?
  avatarUrl   String?
  locale      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@index([userId])
  @@index([token])
}

// ── Character Sheet Templates ──

model Template {
  id                       String                    @id @default(cuid())
  adventureId              String?
  adventure                Adventure?                @relation(fields: [adventureId], references: [id], onDelete: SetNull)
  ownerId                  String
  owner                    User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isPublic                 Boolean                   @default(false)
  useCount                 Int                       @default(0)
  createdFromTemplateId    String?                  @map("created_from_template_id")
  createdFromTemplate      Template?                 @relation("TemplateClones", fields: [createdFromTemplateId], references: [id])
  clonedTemplates          Template[]                @relation("TemplateClones")
  name                     String
  description              String?
  attributeModifierFormula String?
  attributeModifiersEnabled Boolean                  @default(true)
  skillFormula             String?
  attributes               TemplateAttribute[]
  templateFields           TemplateField[]
  templateSkills           TemplateSkill[]
  skillModifierProfiles    SkillModifierProfile[]
  coreResources            TemplateCoreResource[]
  armorClasses             TemplateArmorClass[]
  characterSections        TemplateCharacterSection[]
  resistances              TemplateResistance[]
  characterSheets          CharacterSheet[]
  adventuresUsingAsOriginal Adventure[]               @relation("OriginalTemplateForAdventure")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([adventureId])
  @@index([ownerId])
  @@index([isPublic])
  @@index([useCount])
  @@index([createdFromTemplateId])
}

// ── Skill Modifier Profiles ──

model SkillModifierProfile {
  id                 String                            @id @default(cuid())
  templateId         String
  template           Template                          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name               String
  order              Int                               @default(0)
  targetMode         String                            @default("ALL_SKILLS")
  targetSkillIds     String[]
  options            ProfileOption[]
  skillProfileValues CharacterSheetSkillProfileValue[]
  professionalSkillProfileValues SheetProfessionalSkillProfileValue[]
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt

  @@unique([templateId, name])
  @@index([templateId])
}

model ProfileOption {
  id         String                            @id @default(cuid())
  profileId  String
  profile    SkillModifierProfile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label      String
  value      Float                             @default(0)
  order      Int                               @default(0)
  selections CharacterSheetSkillProfileValue[]
  professionalSkillProfileValues SheetProfessionalSkillProfileValue[]
  createdAt  DateTime                          @default(now())
  updatedAt  DateTime                          @updatedAt

  @@unique([profileId, label])
  @@index([profileId])
}

// ── Character Sheet Skill Profile Values ──

model CharacterSheetSkillProfileValue {
  id        String               @id @default(cuid())
  sheetId   String
  sheet     CharacterSheet       @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  skillId   String
  skill     TemplateSkill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  profileId String
  profile   SkillModifierProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  optionId  String?
  option    ProfileOption?       @relation(fields: [optionId], references: [id], onDelete: SetNull)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([sheetId, skillId, profileId])
  @@index([sheetId])
  @@index([skillId])
}

model TemplateAttribute {
  id                String                            @id @default(cuid())
  templateId        String
  template          Template                          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key               String
  name              String
  order             Int                               @default(0)
  sheetValues       CharacterSheetValue[]
  skills            TemplateSkill[]                   @relation("SkillDefaultAttribute")
  skillsAllowed     TemplateSkill[]                   @relation("SkillAllowedAttributes")
  skillSelections   CharacterSheetSkillValue[]
  resistanceModifiers ResistanceAttributeModifier[]
  sheetResistanceModifiers SheetResistanceAttributeModifier[]
  acModifiers       ArmorClassAttributeModifier[]     @relation("AcAttributeModifierAttribute")
  acDefaultModifiers ArmorClassAttributeModifier[]    @relation("AcAttributeModifierDefault")
  acSelections                CharacterSheetArmorClassAttributeValue[]
  professionalSkills          SheetProfessionalSkill[]
  createdAt                   DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt

  @@index([templateId])
}

// ── Template Skills ──

model TemplateSkill {
  id                 String                            @id @default(cuid())
  templateId         String
  template           Template                          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  attributeId        String?
  attribute          TemplateAttribute?                @relation("SkillDefaultAttribute", fields: [attributeId], references: [id], onDelete: SetNull)
  allowedAttributeIds String[]
  defaultAttributeId String?
  defaultAttribute   TemplateAttribute?                @relation("SkillAllowedAttributes", fields: [defaultAttributeId], references: [id], onDelete: SetNull)
  order              Int                               @default(0)
  skillValues        CharacterSheetSkillValue[]
  skillProfileValues CharacterSheetSkillProfileValue[]
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt

  @@index([templateId])
  @@index([attributeId])
  @@index([defaultAttributeId])
}

// ── Character Sheet Skill Values ──

model CharacterSheetSkillValue {
  id                  String              @id @default(cuid())
  sheetId             String
  sheet               CharacterSheet      @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  skillId             String
  skill               TemplateSkill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  value               String              @default("")
  selectedAttributeId String?
  selectedAttribute   TemplateAttribute?  @relation(fields: [selectedAttributeId], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([sheetId, skillId])
  @@index([sheetId])
  @@index([skillId])
  @@index([selectedAttributeId])
}

// ── Character Sheets ──

model CharacterSheet {
  id                 String                           @id @default(cuid())
  characterName      String
  playerName         String?
  level              Int?                             @default(1)
  hpActual           Int?                             @default(0)
  hpMax              Int?                             @default(0)
  hpNotes            String?                          @default("")
  isNpc              Boolean                          @default(false)
  npcType            String?
  adventureId        String?
  adventure          Adventure?                       @relation(fields: [adventureId], references: [id], onDelete: SetNull)
  templateId         String
  template           Template                         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ownerId            String?
  owner              User?                            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  values             CharacterSheetValue[]
  fieldValues        CharacterSheetFieldValue[]
  skillValues        CharacterSheetSkillValue[]
  skillProfileValues CharacterSheetSkillProfileValue[]
  coreResourceValues CharacterSheetCoreResourceValue[]
  acValues           CharacterSheetArmorClassValue[]
  acAttributeValues  CharacterSheetArmorClassAttributeValue[]
  resistanceValues   CharacterSheetResistanceValue[]
  resistanceComponentValues CharacterSheetResistanceComponentValue[]
  abilities          CharacterAbility[]
  inventoryItems     CharacterInventoryItem[]
  sectionEntries     CharacterSectionEntry[]
  story              CharacterStory?
  sheetResistances     SheetResistance[]
  professionalSkills   SheetProfessionalSkill[]
  createdAt            DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  @@index([adventureId])
  @@index([ownerId])
  @@index([templateId])
  @@index([isNpc])
}

model CharacterSheetValue {
  id          String            @id @default(cuid())
  sheetId     String
  sheet       CharacterSheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   TemplateAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String            @default("")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([sheetId, attributeId])
  @@index([sheetId])
}

// ── Legacy Custom Fields ──

// ── Template Custom Fields ──

model TemplateField {
  id         String                     @id @default(cuid())
  templateId String
  template   Template                   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key        String
  label      String
  order      Int                        @default(0)
  values     CharacterSheetFieldValue[]
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  @@index([templateId])
}

// ── Character Sheet Field Values ──

model CharacterSheetFieldValue {
  id              String         @id @default(cuid())
  sheetId         String
  sheet           CharacterSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  templateFieldId String
  templateField   TemplateField  @relation(fields: [templateFieldId], references: [id], onDelete: Cascade)
  value           String         @default("")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([sheetId, templateFieldId])
  @@index([sheetId])
  @@index([templateFieldId])
}

// ── Point Pools ──

model TemplateCoreResource {
  id               String                              @id @default(cuid())
  templateId       String
  template         Template                            @relation(fields: [templateId], references: [id], onDelete: Cascade)
  slug             String
  displayName      String
  enabled          Boolean                             @default(true)
  editableByPlayer Boolean                             @default(true)
  showNotes        Boolean                             @default(true)
  color            String?
  order            Int                                 @default(0)
  sheetValues      CharacterSheetCoreResourceValue[]
  createdAt        DateTime                            @default(now())
  updatedAt        DateTime                            @updatedAt

  @@unique([templateId, slug])
  @@index([templateId])
}

// ── Character Sheet Point Pool Values ──

model CharacterSheetCoreResourceValue {
  id              String                @id @default(cuid())
  sheetId         String
  sheet           CharacterSheet        @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  coreResourceId  String
  coreResource    TemplateCoreResource  @relation(fields: [coreResourceId], references: [id], onDelete: Cascade)
  current         Int?
  maximum         Int?
  notes           String?               @default("")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([sheetId, coreResourceId])
  @@index([sheetId])
  @@index([coreResourceId])
}

// ── Armor Class (AC) System ──

model TemplateArmorClass {
  id                  String                          @id @default(cuid())
  templateId          String
  template            Template                        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name                String                          @default("Armor Class")
  enabled             Boolean                         @default(false)
  attributeModifiers  ArmorClassAttributeModifier[]
  fields              ArmorClassField[]
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  @@index([templateId])
}

model ArmorClassField {
  id               String                          @id @default(cuid())
  armorClassId     String
  armorClass       TemplateArmorClass              @relation(fields: [armorClassId], references: [id], onDelete: Cascade)
  name             String
  key              String
  defaultValue     String                          @default("0")
  editableByPlayer Boolean                         @default(false)
  description      String?
  order            Int                             @default(0)
  sheetValues      CharacterSheetArmorClassValue[]
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@unique([armorClassId, key])
  @@index([armorClassId])
}

model CharacterSheetArmorClassValue {
  id        String          @id @default(cuid())
  sheetId   String
  sheet     CharacterSheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  fieldId   String
  field     ArmorClassField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value     String          @default("0")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([sheetId, fieldId])
  @@index([sheetId])
  @@index([fieldId])
}

// ── Armor Class Attribute Modifier Selection ──

model ArmorClassAttributeModifier {
  id                    String                                    @id @default(cuid())
  armorClassId          String
  armorClass            TemplateArmorClass                        @relation(fields: [armorClassId], references: [id], onDelete: Cascade)
  attributeId           String
  attribute             TemplateAttribute                         @relation("AcAttributeModifierAttribute", fields: [attributeId], references: [id], onDelete: Cascade)
  allowPlayerSelection  Boolean                                   @default(false)
  defaultAttributeId    String?
  defaultAttribute      TemplateAttribute?                        @relation("AcAttributeModifierDefault", fields: [defaultAttributeId], references: [id], onDelete: SetNull)
  sheetValues           CharacterSheetArmorClassAttributeValue[]
  createdAt             DateTime                                  @default(now())
  updatedAt             DateTime                                  @updatedAt

  @@unique([armorClassId, attributeId])
  @@index([armorClassId])
  @@index([attributeId])
}

model CharacterSheetArmorClassAttributeValue {
  id                    String                        @id @default(cuid())
  sheetId               String
  sheet                 CharacterSheet                @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  acAttributeModifierId String
  acAttributeModifier   ArmorClassAttributeModifier   @relation(fields: [acAttributeModifierId], references: [id], onDelete: Cascade)
  selectedAttributeId   String?
  selectedAttribute     TemplateAttribute?            @relation(fields: [selectedAttributeId], references: [id], onDelete: SetNull)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  @@unique([sheetId, acAttributeModifierId])
  @@index([sheetId])
  @@index([acAttributeModifierId])
  @@index([selectedAttributeId])
}

// ── Resistance System ──

model TemplateResistance {
  id               String                          @id @default(cuid())
  templateId       String
  template         Template                        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name             String
  calculationType  String                          @default("MANUAL")
  order            Int                             @default(0)
  components       ResistanceComponent[]
  attributeModifiers ResistanceAttributeModifier[]
  sheetValues       CharacterSheetResistanceValue[]
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@index([templateId])
}

model ResistanceComponent {
  id               String                                        @id @default(cuid())
  resistanceId     String
  resistance       TemplateResistance                            @relation(fields: [resistanceId], references: [id], onDelete: Cascade)
  name             String
  editableByPlayer Boolean                                       @default(false)
  defaultValue     String                                        @default("0")
  order            Int                                           @default(0)
  sheetValues      CharacterSheetResistanceComponentValue[]
  createdAt        DateTime                                      @default(now())
  updatedAt        DateTime                                      @updatedAt

  @@index([resistanceId])
}

model ResistanceAttributeModifier {
  id          String            @id @default(cuid())
  resistanceId String
  resistance TemplateResistance @relation(fields: [resistanceId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   TemplateAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  enabled     Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([resistanceId, attributeId])
  @@index([resistanceId])
  @@index([attributeId])
}

model CharacterSheetResistanceValue {
  id           String              @id @default(cuid())
  sheetId      String
  sheet        CharacterSheet      @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  resistanceId String
  resistance   TemplateResistance  @relation(fields: [resistanceId], references: [id], onDelete: Cascade)
  manualValue  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([sheetId, resistanceId])
  @@index([sheetId])
  @@index([resistanceId])
}

model CharacterSheetResistanceComponentValue {
  id          String              @id @default(cuid())
  sheetId     String
  sheet       CharacterSheet      @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  componentId String
  component   ResistanceComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  value       String              @default("0")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([sheetId, componentId])
  @@index([sheetId])
  @@index([componentId])
}

// ── Sheet-Specific Resistances (owned by a single CharacterSheet) ──

model SheetResistance {
  id                 String                           @id @default(cuid())
  sheetId            String
  sheet              CharacterSheet                   @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  name               String
  calculationType    String                           @default("MANUAL")
  order              Int                              @default(0)
  components         SheetResistanceComponent[]
  attributeModifiers SheetResistanceAttributeModifier[]
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  @@index([sheetId])
}

model SheetResistanceComponent {
  id                String           @id @default(cuid())
  sheetResistanceId String
  sheetResistance   SheetResistance  @relation(fields: [sheetResistanceId], references: [id], onDelete: Cascade)
  name              String
  editableByPlayer  Boolean          @default(false)
  value             String           @default("0")
  order             Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([sheetResistanceId])
}

model SheetResistanceAttributeModifier {
  id                String           @id @default(cuid())
  sheetResistanceId String
  sheetResistance   SheetResistance  @relation(fields: [sheetResistanceId], references: [id], onDelete: Cascade)
  attributeId       String
  attribute         TemplateAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  enabled           Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([sheetResistanceId, attributeId])
  @@index([sheetResistanceId])
  @@index([attributeId])
}

// ── Professional Skills (character-specific, not template-defined) ──

model SheetProfessionalSkill {
  id            String                              @id @default(cuid())
  sheetId       String
  sheet         CharacterSheet                      @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  name          String
  attributeId   String?
  attribute     TemplateAttribute?                   @relation(fields: [attributeId], references: [id], onDelete: SetNull)
  order         Int                                 @default(0)
  profileValues SheetProfessionalSkillProfileValue[]
  createdAt     DateTime                            @default(now())
  updatedAt     DateTime                            @updatedAt

  @@unique([sheetId, name])
  @@index([sheetId])
  @@index([attributeId])
}

model SheetProfessionalSkillProfileValue {
  id                        String                  @id @default(cuid())
  sheetProfessionalSkillId  String
  sheetProfessionalSkill    SheetProfessionalSkill   @relation(fields: [sheetProfessionalSkillId], references: [id], onDelete: Cascade)
  profileId                 String
  profile                   SkillModifierProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  optionId                  String?
  option                    ProfileOption?           @relation(fields: [optionId], references: [id], onDelete: SetNull)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@unique([sheetProfessionalSkillId, profileId])
  @@index([sheetProfessionalSkillId])
  @@index([profileId])
}

// ── Character Abilities & Summons (Player-only) ──

model CharacterAbility {
  id               String               @id @default(cuid())
  sheetId          String
  sheet            CharacterSheet       @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  summonId         String?
  parentSummon     CharacterAbility?    @relation("SummonAbilities", fields: [summonId], references: [id], onDelete: Cascade)
  name             String
  type             String               @default("ABILITY") // "ABILITY" | "SUMMON"
  order            Int                  @default(0)
  description      String?
  notes            String?
  levels           CharacterAbilityLevel[]
  summonAttributes  SummonAttribute[]
  summonAcValues    SummonArmorClassValue[]
  summonHealth      SummonHealth?
  summonSkills      SummonSkill[]
  childAbilities   CharacterAbility[]   @relation("SummonAbilities")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([sheetId])
  @@index([summonId])
}

model CharacterAbilityLevel {
  id          String           @id @default(cuid())
  abilityId   String
  ability     CharacterAbility @relation(fields: [abilityId], references: [id], onDelete: Cascade)
  level       String
  manaCost    Int?
  range       String?
  description String?
  notes       String?
  damage      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([abilityId, level])
  @@index([abilityId])
}

// ── Summon Skills (skills selected for a specific summon) ──

model SummonSkill {
  id          String           @id @default(cuid())
  abilityId   String
  ability     CharacterAbility @relation(fields: [abilityId], references: [id], onDelete: Cascade)
  name        String
  manualValue Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([abilityId])
}

// ── Summon Attribute Values (reuses template attributes) ──

model SummonAttribute {
  id          String           @id @default(cuid())
  abilityId   String
  ability     CharacterAbility @relation(fields: [abilityId], references: [id], onDelete: Cascade)
  attributeId String
  value       String           @default("")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([abilityId, attributeId])
  @@index([abilityId])
}

// ── Summon Armor Class (single manual value per summon) ──

model SummonArmorClassValue {
  id        String           @id @default(cuid())
  abilityId String           @unique
  ability   CharacterAbility @relation(fields: [abilityId], references: [id], onDelete: Cascade)
  value     String           @default("10")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([abilityId])
}

// ── Summon Health ──

model SummonHealth {
  id        String           @id @default(cuid())
  abilityId String           @unique
  ability   CharacterAbility @relation(fields: [abilityId], references: [id], onDelete: Cascade)
  current   Int?
  maximum   Int?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// ── Character Inventory Items (Player-only) ──

model CharacterInventoryItem {
  id          String         @id @default(cuid())
  sheetId     String
  sheet       CharacterSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  name        String
  weight      Float?
  cost        String?
  description String?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([sheetId])
}

// ── Character Story (Player-only, one-to-one) ──

model CharacterStory {
  id          String         @id @default(cuid())
  sheetId     String         @unique
  sheet       CharacterSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  appearance  String?        @default("")
  backstory   String?        @default("")
  personality String?        @default("")
  goals       String?        @default("")
  notes       String?        @default("")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// ── Character Sections (GM-defined custom sections) ──

model TemplateCharacterSection {
  id         String                   @id @default(cuid())
  templateId String
  template   Template                 @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  order      Int                      @default(0)
  entries    CharacterSectionEntry[]
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@index([templateId])
}

model CharacterSectionEntry {
  id          String                   @id @default(cuid())
  sheetId     String
  sheet       CharacterSheet           @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  sectionId   String
  section     TemplateCharacterSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name        String
  description String                   @default("")
  notes       String?
  order       Int                      @default(0)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([sheetId])
  @@index([sectionId])
}

// ── Subscription Models ──

enum SubscriptionStatus {
  PENDING
  AUTHORIZED
  ACTIVE
  GRACE
  EXPIRED
  CANCELLED
}

model SubscriptionPlan {
  id            String              @id
  slug          String              @unique
  name          String
  description   String?
  price         Int
  mpPlanId      String              @unique
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  subscriptions UserSubscription[]
}

model UserSubscription {
  id                 String               @id @default(cuid())
  userId             String               @unique
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               SubscriptionPlan     @relation(fields: [planId], references: [id])
  mpSubscriptionId   String?              @unique
  status             SubscriptionStatus   @default(PENDING)
  graceEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  invoices           SubscriptionInvoice[]

  @@index([userId])
  @@index([status])
}

model SubscriptionInvoice {
  id              String             @id @default(cuid())
  subscriptionId  String
  subscription    UserSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  mpInvoiceId     String?            @unique
  amount          Int
  currency        String             @default("BRL")
  status          String             @default("pending")
  paidAt          DateTime?
  dueDate         DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([subscriptionId])
  @@index([mpInvoiceId])
}